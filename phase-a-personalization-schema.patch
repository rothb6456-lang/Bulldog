+{
+    use HasFactory, HasUuid;
+
+    protected $keyType = 'string';
+    public $incrementing = false;
+
+    protected $fillable = [
+        'player_identity_id',
+        'phase_id',
+        'goal_template_id',
+        'title',
+        'description',
+        'target_metric_key',
+        'target_value',
+        'target_unit',
